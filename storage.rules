rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isImage(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /garments/{garmentId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /logos/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isImage(5 * 1024 * 1024);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /final-renders/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isImage(10 * 1024 * 1024);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
