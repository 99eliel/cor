rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /garments/{garmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.garmentId is string
        && request.resource.data.colorChoices is map
        && request.resource.data.logos is list
        && request.resource.data.finalImages is map;
      allow read, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /logoAssets/{hash} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.hash == hash;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
