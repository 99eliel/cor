rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isPublicApprovalUpdate() {
      return request.auth == null
        && resource.data.approvalStatus == 'pending'
        && resource.data.approvalToken is string
        && request.resource.data.approvalProof == resource.data.approvalToken
        && request.resource.data.approvalStatus in ['approved', 'changes_requested']
        && request.resource.data.status in ['approved', 'approval']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalProof',
          'approvalStatus',
          'approvalNote',
          'approvalRespondedAt',
          'status',
          'updatedAt'
        ]);
    }

    match /garments/{garmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.garmentId is string
        && request.resource.data.colorChoices is map
        && request.resource.data.logos is list
        && request.resource.data.finalImages is map;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() || isPublicApprovalUpdate();
    }

    match /approvalPreviews/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.orderId is string;
      allow update: if request.auth == null
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'changes_requested']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'note',
          'respondedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /logoAssets/{hash} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hash == hash
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.url is string;
      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
